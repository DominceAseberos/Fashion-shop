{
  "kind": "collectionType",
  "collectionName": "journal_posts",
  "info": {
    "singularName": "journal-post",
    "pluralName": "journal-posts",
    "displayName": "Journal Post",
    "description": "Editorial journal articles and notes from the house"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "eyebrow": {
      "type": "string"
    },
    "intro": {
      "type": "text"
    },
    "content": {
      "type": "blocks"
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    }
  }
}
